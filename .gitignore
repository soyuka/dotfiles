/*
!.config
.config/*
!.config/nvim
# alacritty replaced by foot (2026-07-30); its config stays on disk but untracked.
!.config/foot
!.config/borgmatic
!.config/clight.conf
!.config/mako
!.config/git/attributes
!.config/sway
!.config/swaylock
!.config/systemd
!.config/waybar
!.config/wofi
!.config/zsh
!.config/zathura/zathurarc
.config/zsh/antigen.zsh
.config/zsh/soyuka.zsh-theme.antigen-compat
!.gitconfig
!.github
# .local needs the same three-step form as .config above: /* excludes
# .local, and git cannot re-include a path whose parent dir is excluded —
# so the bare `!.local/bin/dnm` below never worked (verified 2026-09-03:
# `git ls-files .local/` was empty).
!.local
.local/*
!.local/bin
.local/bin/*
!.local/bin/dnm
# tmux agent strip (status line 1) + its fzf switcher; ~/.tmux.conf calls all three
!.local/bin/claude-tmux-state
!.local/bin/claude-agent-switcher
!.local/bin/tmux-agent-budget
!.local/bin/tests
!.tmux.conf
!.vimrc
.vim/*
!.vim/ftplugin
!.vim/autoload
!.vim/colors
!.zprofile
!.zshrc
.config/systemd/user/borgmatic.service.d/override.conf
.secret_env
GEMINI.md

# Ad-hoc backups (foo.bak, foo.bak-20260730-230455). Must stay last: whitelist
# entries above re-include whole directories, and last match wins.
*.bak
*.bak-*

# systemctl edit / emacs lock temp files. `.#override.conf<hash>` slipped past the
# override.conf rule above and published a live BORG_PASSPHRASE for three years.
.#*
