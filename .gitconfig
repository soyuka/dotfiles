[user]
	email = soyuka@users.noreply.github.com
	name = soyuka
	signingkey = 3F82299C64F51AD2
[core]
	excludesfile = /home/soyuka/.gitignore-global
	editor = nvim
[init]
	defaultBranch = main
[commit]
	gpgsign = true
[committer]
	email = soyuka@users.noreply.github.com
[push]
	autoSetupRemote = true

[merge "ours"]
	driver = true
[merge "union"]
	driver = true
[rerere]
	enabled = true
[credential]
	helper = libsecret
[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f

# Machine-local overrides (work paths, per-host tweaks). Untracked; missing is fine.
[include]
	path = .gitconfig.local
